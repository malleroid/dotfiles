#!/bin/bash

# ollama
if ! command -v ollama >/dev/null 2>&1; then
  echo "Installing ollama..."
  curl -fsSL https://ollama.com/install.sh | sh
fi

# claude code
if ! command -v claude >/dev/null 2>&1; then
  echo "Installing Claude Code..."
  curl -fsSL https://claude.ai/install.sh | sh
fi

# opencode
if ! command -v opencode >/dev/null 2>&1; then
  echo "Installing OpenCode..."
  curl -fsSL https://opencode.ai/install | sh
fi

# antigravity cli (agy)
if ! command -v agy >/dev/null 2>&1; then
  echo "Installing Antigravity CLI (agy)..."
  curl -fsSL https://antigravity.google/cli/install.sh | bash
fi

# muse code (Meta); the launcher self-updates, so install only when missing
if ! command -v muse >/dev/null 2>&1; then
  echo "Installing Muse Code..."
  curl -fsSL https://dev.meta.ai/install.sh | MUSE_NO_MODIFY_PATH=1 bash
fi

# grok build (xAI); self-updates via `grok update`, so install only when missing
if ! command -v grok >/dev/null 2>&1; then
  echo "Installing Grok Build..."
  curl -fsSL https://x.ai/cli/install.sh | bash
fi

# beads (always run to keep up-to-date)
echo "Installing/updating beads..."
curl -fsSL https://raw.githubusercontent.com/steveyegge/beads/main/scripts/install.sh | bash

# terminal-browser (kitty graphics protocol browser; run in kitty, not zellij)
if ! command -v terminal-browser >/dev/null 2>&1; then
  echo "Installing terminal-browser..."
  curl -fsSl https://terminal-browser.sh/install | bash
fi
