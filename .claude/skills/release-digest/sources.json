[
  {
    "id": "claude-code",
    "name": "Claude Code",
    "fetch": {
      "gh": "repos/anthropics/claude-code/releases?per_page=100"
    },
    "parser": "bin/parse-claude-code.py",
    "unit": "version",
    "spec": "sources/claude-code.md",
    "enabled": true
  },
  {
    "id": "dev-platform",
    "name": "Claude Platform (API)",
    "fetch": {
      "url": "https://platform.claude.com/docs/en/release-notes/overview.md"
    },
    "parser": "bin/parse-relnotes.py",
    "unit": "date",
    "spec": "sources/dev-platform.md",
    "enabled": true
  },
  {
    "id": "claude-apps",
    "name": "Claude Apps",
    "fetch": {
      "url": "https://support.claude.com/en/articles/12138966-release-notes.md"
    },
    "parser": "bin/parse-apps.py",
    "unit": "date",
    "spec": "sources/claude-apps.md",
    "enabled": true
  },
  {
    "id": "openai-api",
    "name": "OpenAI API",
    "fetch": {
      "url": "https://developers.openai.com/api/docs/changelog"
    },
    "parser": "bin/parse-oai-api.py",
    "unit": "date",
    "spec": "sources/openai-api.md",
    "enabled": true
  },
  {
    "id": "openai-codex",
    "name": "OpenAI Codex",
    "fetch": {
      "url": "https://developers.openai.com/codex/changelog"
    },
    "parser": "bin/parse-oai-codex.py",
    "unit": "date",
    "spec": "sources/openai-codex.md",
    "enabled": true
  },
  {
    "id": "gemini-api",
    "name": "Gemini API",
    "fetch": {
      "url": "https://aistudio.google.com/docs/changelog.md"
    },
    "parser": "bin/parse-gemini-api.py",
    "unit": "date",
    "spec": "sources/gemini-api.md",
    "enabled": true,
    "notes": "2026-11 に ai.google.dev から aistudio.google.com/docs/changelog へ移転。.md 版を parse する"
  },
  {
    "id": "gemini-app",
    "name": "Gemini App",
    "fetch": {
      "url": "https://gemini.google/release-notes/?hl=en"
    },
    "parser": "bin/parse-gemini-app.py",
    "unit": "date",
    "spec": "sources/gemini-app.md",
    "enabled": true
  },
  {
    "id": "xai",
    "name": "xAI / Grok",
    "fetch": {
      "url": "https://docs.x.ai/docs/release-notes"
    },
    "parser": "bin/parse-xai.py",
    "unit": "date",
    "spec": "sources/xai.md",
    "enabled": true,
    "notes": "docs.x.ai は月見出しに当年の年を持たず Last updated から推定する。x.ai/news (消費者向け) は Cloudflare 403 で対象外"
  },
  {
    "id": "antigravity",
    "name": "Antigravity",
    "fetch": {
      "url": "https://antigravity.google/docs/changelog"
    },
    "parser": "bin/parse-antigravity.py",
    "unit": "version",
    "spec": "sources/antigravity.md",
    "enabled": true,
    "notes": "docs/changelog（Astro の静的ページ）を parse する。App / CLI / IDE / SDK / IDE 拡張（VS Code・JetBrains 等）の各パネルの release-entry を version 単位で出す。release-entry が 1 件も取れなければ parser が fail-loud で落ちる"
  },
  {
    "id": "github-changelog",
    "name": "GitHub Changelog",
    "fetch": {
      "url": "https://github.blog/changelog/feed/"
    },
    "parser": "bin/parse-github-changelog.py",
    "unit": "item",
    "spec": "sources/github-changelog.md",
    "enabled": true,
    "notes": "GitHub プラットフォーム全体 (Copilot/Actions/security 等)。RSS の category(changelog-type/label)を分類ヒントに label グルーピングで出力する"
  },
  {
    "id": "copilot-cli",
    "name": "GitHub Copilot CLI",
    "fetch": {
      "gh": "repos/github/copilot-cli/releases?per_page=100"
    },
    "parser": "bin/parse-copilot-cli.py",
    "unit": "version",
    "spec": "sources/copilot-cli.md",
    "enabled": true
  },
  {
    "id": "opencode",
    "name": "opencode",
    "fetch": {
      "gh": "repos/anomalyco/opencode/releases?per_page=100"
    },
    "parser": "bin/parse-opencode.py",
    "unit": "version",
    "spec": "sources/opencode.md",
    "enabled": true
  },
  {
    "id": "kiro",
    "name": "Kiro",
    "fetch": {
      "url": "https://kiro.dev/changelog/feed.atom"
    },
    "parser": "bin/parse-kiro.py",
    "unit": "entry",
    "spec": "sources/kiro.md",
    "enabled": true
  },
  {
    "id": "chatgpt",
    "name": "ChatGPT",
    "fetch": null,
    "parser": null,
    "unit": "date",
    "spec": null,
    "enabled": false,
    "notes": "help.openai.com/en/articles/6825453 が Cloudflare challenge で curl/WebFetch とも 403 (2026-06)。真っ当な取得手段が現れたら enable する。大きな発表は openai-api / News にも載るため当面の実害は小"
  }
]
